:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:comment "A technique used to collect the data."@en ;
    rdfs:subClassOf :Procedure .

:Identification a owl:Class ;
    rdfs:label "Identification"@en ;
    rdfs:comment "A technique used identify the data that must be collected"@en ;
    rdfs:subClassOf :Procedure .

:Irritability a owl:Class ;
    rdfs:label "Irritability"@en ;
    rdfs:comment "The quality or state of being easily annoyed or provoked to anger."@en ;
    rdfs:subClassOf :Feeling .

:MedicalRecord a owl:Class ;
    rdfs:label "Medical Records"@en ;
    rdfs:comment "Medical records generated by a professional recording the relevant information after a medical or therapeutic appointment."@en ;
    rdfs:subClassOf :Context .

:Memory a owl:Class ;
    rdfs:label "Memory difficulty"@en ;
    rdfs:comment "Difficulty retrieving memories, a cognitive symptom associated with depression."@en ;
    rdfs:subClassOf :Cognition .

:Profile a owl:Class ;
    rdfs:label "Profile"@en ;
    rdfs:comment "A publication on a social media platform, presented as a profile, represents an update of the users profile, usually whitout timestamp that overwrite the previous content."@en ;
    rdfs:subClassOf :Publication .

:Psychotic a owl:Class ;
    rdfs:label "Psychotic"@en ;
    rdfs:comment "Conditions related to psychosis disorders, which includes delusions or hallucinations, often involving a loss of contact with reality."@en ;
    rdfs:subClassOf :Condition .

:Storage a owl:Class ;
    rdfs:label "Evidence storage procedure"@en ;
    rdfs:comment "Procedure step for storing collected digital evidence with integrity controls."@en ;
    rdfs:subClassOf :Procedure ;
    owl:disjointWith :Memory .

:Trace01 a :Relation,
        owl:NamedIndividual ;
    :hasExplanation "the text includes a name, \"[REDACTED],\" which is the name of the cat" ;
    :isFoundUsing :LLMTraceDetection .

:Trace02 a :Feeling,
        owl:NamedIndividual ;
    :hasExplanation "The text expresses gratitude and surprise, and it implicitly conveys feelings of regret for the delayed acknowledgment. These sentiments relate to gratitude and regret." ;
    :isFoundUsing :LLMTraceDetection .

:Trace03 a :Condition,
        owl:NamedIndividual ;
    :hasExplanation "The text mentions an impact on physical condition due to the pandemic, which affected the ability to attend a [REDACTED]." ;
    :isFoundUsing :LLMTraceDetection .

:Trace04 a :Feeling,
        owl:NamedIndividual ;
    :hasExplanation "the text conveys a sense of hope and positivity by offering the companionship of kittens, which can relate to feelings of pleasure and joy." ;
    :isFoundUsing :LLMTraceDetection .

:Trace05 a owl:NamedIndividual ;
    :hasExplanation "Potentially, the inability to continue drawing could be linked to feelings like frustration or sadness, but these are not explicitly stated in the text." ;
    :isFoundUsing :LLMTraceDetection .

:Trace06 a :Relation,
        owl:NamedIndividual ;
    :hasExplanation "includes a relationship context (interaction with a coworker)" ;
    :isFoundUsing :LLMTraceDetection .

:Trace07 a :Feeling,
        owl:NamedIndividual ;
    :hasExplanation "the text conveys humor and perhaps curiosity about self-appearance which could relate to the feelings of amusement or curiosity." ;
    :isFoundUsing :LLMTraceDetection .

:Trace08 a :Irritability,
        owl:NamedIndividual ;
    :hasExplanation "the text might convey a sense of urgency or mild distress about needing a plate for lunch, which can relate to feelings of annoyance or frustration. The message humorously expresses a minor inconvenience (a missing plate) and uses personification (\"Human, my plate was missing\") to add character to the statement, likely meant to amuse or engage social media followers." ;
    :isFoundUsing :LLMTraceDetection .

:Trace09 a :Relation,
        owl:NamedIndividual ;
    :hasExplanation "The text indicates a relationship of affection and loss (the speaker and the deceased referred to as \"dear [REDACTED]\")" ;
    :isFoundUsing :LLMTraceDetection .

:Trace10 a owl:NamedIndividual ;
    :hasExplanation "Yes, the text conveys sentiments of sadness and loss due to the death of \"dear [REDACTED],\" which might be a nickname for a beloved pet or individual. It also expresses a hopeful sentiment that \"Heaven became a happier place.\"" ;
    :isFoundUsing :LLMTraceDetection .

:Trace11 a :Feeling,
        owl:NamedIndividual ;
    :hasExplanation "Potentially, it could suggest a sense of renewal or change, given the update of a profile picture after a significant period. However, these feelings are not explicitly mentioned." ;
    :isFoundUsing :LLMTraceDetection .

:Trace12 a :AlcoholUse,
        owl:NamedIndividual ;
    :hasExplanation "The text mentions [REDACTED], which indicates alcohol use." ;
    :isFoundUsing :LLMTraceDetection .

:Trace13 a :Feeling,
        owl:NamedIndividual ;
    :hasExplanation "The text conveys a range of sentiments including overcoming [REDACTED], personal growth, and a sense of victory. These can relate to sentiments of hope, perseverance, and happiness." ;
    :isFoundUsing :LLMTraceDetection .

:Trace14 a :Condition,
        owl:NamedIndividual ;
    :hasExplanation "The mention of no longer using a [REDACTED] and experiencing [REDACTED] indicates a physical condition, potentially an injury or chronic condition, that has been managed over time." ;
    :isFoundUsing :LLMTraceDetection .

:Trace15 a :Event,
        owl:NamedIndividual ;
    :hasExplanation "mentions a significant life event (returning to [REDACTED]), a physical condition ([REDACTED]), and personal lifestyle changes." ;
    :isFoundUsing :LLMTraceDetection .

:Trace16 a :Feeling,
        owl:NamedIndividual ;
    :hasExplanation "Potentially, the text might convey a sense of relaxation or enjoyment from engaging in a leisure activity (drawing) during the holidays, but these sentiments are not explicitly mentioned." ;
    :isFoundUsing :LLMTraceDetection .

:Trace17 a :Feeling,
        owl:NamedIndividual ;
    :hasExplanation "the text might convey sentiments of disappointment or dissatisfaction regarding the artistic outcome, reflecting feelings such as frustration." ;
    :isFoundUsing :LLMTraceDetection .

:comesFromSocialPlatform a owl:DatatypeProperty ;
    rdfs:label "comesFromSocialPlatform"@en ;
    rdfs:comment "The social media platform where the publication was published"@en ;
    rdfs:domain :Account ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:isAbout a owl:ObjectProperty ;
    rdfs:label "isAbout"@en ;
    rdfs:comment "A context is about a specific person"@en ;
    rdfs:domain :Context ;
    rdfs:range :Person ;
    rdfs:subPropertyOf owl:topObjectProperty .

:isFoundIn a owl:ObjectProperty ;
    rdfs:label "isFoundIn"@en ;
    rdfs:comment "A trace is found in a specific publication or medical record"@en ;
    rdfs:domain :Trace ;
    rdfs:range :Context ;
    rdfs:subPropertyOf owl:topObjectProperty .

:isFoundUsing a owl:ObjectProperty ;
    rdfs:label "isFoundUsing"@en ;
    rdfs:comment "A trace is found using a specific procedure"@en ;
    rdfs:domain :Trace ;
    rdfs:range :Procedure ;
    rdfs:subPropertyOf owl:topObjectProperty .

:isPreservedAs a owl:ObjectProperty ;
    rdfs:label "isPreservedAs"@en ;
    rdfs:comment "An artifact generated to preserve a social media publication"@en ;
    rdfs:domain :Publication ;
    rdfs:range :Artifact ;
    rdfs:subPropertyOf owl:topObjectProperty .

:isResultOf a owl:ObjectProperty ;
    rdfs:label "isResultOf"@en ;
    rdfs:comment "An artifact is the result of a procedure"@en ;
    rdfs:domain :Artifact ;
    rdfs:range :Procedure ;
    rdfs:subPropertyOf owl:topObjectProperty .

:owns a owl:ObjectProperty ;
    rdfs:label "owns"@en ;
    rdfs:comment "The relation of a person with his social media  account"@en ;
    rdfs:domain :Person ;
    rdfs:range :Account ;
    rdfs:subPropertyOf owl:topObjectProperty .

:Bipolar a owl:Class ;
    rdfs:label "Bipolar"@en ;
    rdfs:comment "A psychiatric condition characterized by extreme mood swings, including manic and depressive episodes."@en ;
    rdfs:subClassOf :Condition .

:Sleep a owl:Class ;
    rdfs:label "Sleep"@en ;
    rdfs:comment "Sleep refers to traces of the natural state of rest undergo by people"@en ;
    rdfs:subClassOf :Behaviour .

:SuicidalBehaviour a owl:Class ;
    rdfs:label "Suicidal Behaviour"@en ;
    rdfs:comment "Suicidal behavior refers to actions or thoughts that involve an individual contemplating or attempting to take their own life."@en ;
    rdfs:subClassOf :Behaviour .

:Analisys a owl:Class ;
    rdfs:label "Analisys"@en ;
    rdfs:comment "A technique for turning data into intelligence."@en ;
    rdfs:subClassOf :Procedure .

:Relation a owl:Class ;
    rdfs:label "Relation"@en ;
    rdfs:comment "Refers to a significant connection with someone like a parent or a pet, characterized by emotional bonds and personal attachment."@en ;
    rdfs:subClassOf :Trace .

:hasContent a owl:DatatypeProperty ;
    rdfs:label "hasContent"@en ;
    rdfs:comment "The content of a social media publication in general"@en ;
    rdfs:domain :Context ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:Behaviour a owl:Class ;
    rdfs:label "Behaviour"@en ;
    rdfs:comment "Behavior encompasses actions, reactions, or conduct displayed by individuals in various situations, reflecting their thoughts, feelings, and intentions."@en ;
    rdfs:subClassOf :Trace .

:Account a owl:Class ;
    rdfs:label "Account"@en ;
    rdfs:comment "A personal social media account"@en .

:Cognition a owl:Class ;
    rdfs:label "Cognition"@en ;
    rdfs:comment "The mental action or process of acquiring knowledge and understanding through thought, experience, and the senses."@en ;
    rdfs:subClassOf :Trace .

:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "A significant event in a persons life that can affected a depression diagnoses"@en ;
    rdfs:subClassOf :Trace .

:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "A state of health, whether normal or disrupted, that may influences the depression diagnosis."@en ;
    rdfs:subClassOf :Trace .

:Context a owl:Class ;
    rdfs:label "Context"@en ;
    rdfs:comment "Historical data and conditions that influence or relate to the current state and behavior of the subject."@en .

:Procedure a owl:Class ;
    rdfs:label "Procedure"@en ;
    rdfs:comment "A technique used to turn raw data into intelligence."@en .

:Publication a owl:Class ;
    rdfs:label "Publication"@en ;
    rdfs:comment "A publication made in a social media platform by a person"@en ;
    rdfs:subClassOf :Context .

:Trace a owl:Class ;
    rdfs:label "Trace"@en ;
    rdfs:comment "A subtype of material evidence is trace evidence, which consists of small amounts (often microscopic) of material found at a crime scene that can also be relevant to an investigation."@en .

:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A person subject of the investigation"@en .

:Post a owl:Class ;
    rdfs:label "Post"@en ;
    rdfs:comment "A publication on a social media platform, presented as a post, represents a timestamped update that remains independent from other posts, contrasting with profile updates that overwrite the previous content."@en ;
    rdfs:subClassOf :Publication .

:LLMTranslation a :Analisys,
        owl:NamedIndividual .

:RegularAPIExtraction a :Collection,
        owl:NamedIndividual .

:SQLliteLocalDatabase a :Storage,
        owl:NamedIndividual .

:UserSharing a :Identification,
        owl:NamedIndividual .

:VADERSentimentScoring a :Analisys,
        owl:NamedIndividual .

:Person01 a :Person,
        owl:NamedIndividual ;
    :hasEducation "REDACTED" ;
    :hasEthnicity "REDACTED" ;
    :hasFamily "Mother" ;
    :hasGender "REDACTED" ;
    :hasIncome "REDACTED" ;
    :hasName "REDACTED" ;
    :hasRelationship "Friend 01",
        "Friend 02" ;
    :owns :AccountID1 .

:LLMTraceDetection a :Analisys,
        owl:NamedIndividual .

:Feeling a owl:Class ;
    rdfs:label "Feeling"@en ;
    rdfs:comment "An emotional state or reaction that is experienced internally and expressed outwardly"@en ;
    rdfs:subClassOf :Trace .

:Artifact a owl:Class ;
    rdfs:label "Artifact"@en ;
    rdfs:comment "Any data that provides evidence of computer activity or digital interactions, preserved for analysis and trackability."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( :Account :Artifact :Context :Person :Procedure :Trace ) .

