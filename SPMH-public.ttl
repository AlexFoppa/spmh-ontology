@prefix : <http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator rdfs:label "creator"@en ;
    rdfs:comment "Names the entity primarily responsible for making the resource."@en .

dc:description rdfs:label "description"@en ;
    rdfs:comment "Describes the resource in free text."@en .

dc:title rdfs:label "title"@en ;
    rdfs:comment "Names the resource."@en .

dcterms:license rdfs:label "license"@en ;
    rdfs:comment "Legal document giving official permission to do something with the resource."@en .

<http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH> a owl:Ontology ;
    rdfs:label "Serapis Personal Mental Health Ontology (SPMH)"@en ;
    dc:creator "Alexandre Augusto Foppa, Wesllei Felipe Heckler, Luan Paris Feijó, Jorge Luis Victória Barbosa" ;
    dc:description "Trace-based ontology for organizing depression-related social media evidence with provenance, aligned with DSM-5-TR diagnostic criteria."@en ;
    dc:title "Serapis Personal Mental Health Ontology (SPMH)" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.0.4" .

:Appetite a owl:Class ;
    rdfs:label "Appetite"@en ;
    rdfs:comment "The natural desire to satisfy bodily needs for food."@en ;
    rdfs:subClassOf :Feeling .

:Birth a owl:Class ;
    rdfs:label "Birth"@en ;
    rdfs:comment "The birth of a child"@en ;
    rdfs:subClassOf :Event .

:ChildhoodExperiences a owl:Class ;
    rdfs:label "Childhood Experiences"@en ;
    rdfs:comment "Any traumas or memorable experiences from the person's childhood that may influence a depression diagnosis"@en ;
    rdfs:subClassOf :Event .

:Concentration a owl:Class ;
    rdfs:label "Concentration"@en ;
    rdfs:comment "The ability to focus attention on a task for a sustained period of time."@en ;
    rdfs:subClassOf :Cognition .

:Death a owl:Class ;
    rdfs:label "Death"@en ;
    rdfs:comment "A death of a familiar, friend or any significant people that may cause grief, including pets."@en ;
    rdfs:subClassOf :Event .

:DecisionMaking a owl:Class ;
    rdfs:label "DecisionMaking"@en ;
    rdfs:comment "The process of making choices by identifying options and assessing the impact of each option."@en ;
    rdfs:subClassOf :Cognition .

:Delusion a owl:Class ;
    rdfs:label "Delusion"@en ;
    rdfs:comment "A false belief held with strong conviction despite superior evidence to the contrary."@en ;
    rdfs:subClassOf :Cognition .

:DepressedMood a owl:Class ;
    rdfs:label "DepressedMood"@en ;
    rdfs:comment "Persistent sadness and a lack of interest or pleasure in previously rewarding or enjoyable activities. Synonyms: Sadness, Rumination, Worthlessness, Distress, Indecisiveness, Hopelessness, Melancholy and Loneliness"@en ;
    rdfs:subClassOf :Feeling ;
    skos:altLabel "Distress"@en,
        "Hopelessness"@en,
        "Indecisiveness"@en,
        "Loneliness"@en,
        "Melancholy"@en,
        "Rumination"@en,
        "Sadness"@en,
        "Worthlessness"@en .

:Depression a owl:Class ;
    rdfs:label "Depression"@en ;
    rdfs:comment "A psychiatric condition marked by significant sadness, lack of energy, and low mood."@en ;
    rdfs:subClassOf :Condition .

:Discrimination a owl:Class ;
    rdfs:label "Discrimination"@en ;
    rdfs:comment "Unjust or prejudicial treatment of different categories of people, often based on race, age, or gender."@en ;
    rdfs:subClassOf :Feeling .

:Fatigue a owl:Class ;
    rdfs:label "Fatigue"@en ;
    rdfs:comment "Fatigue is a state of tiredness or exhaustion resulting from mental or physical exertion or illness. Synonyms:Burrden, Energy (Lack of), Tiredness"@en ;
    rdfs:subClassOf :Feeling ;
    skos:altLabel "Burden"@en,
        "Energy (Lack of)"@en,
        "Tiredness"@en .

:Gastrointestinal a owl:Class ;
    rdfs:label "Gastrointestinal"@en ;
    rdfs:comment "Disturbances in the stomach and intestines."@en ;
    rdfs:subClassOf :Condition .

:Guilt a owl:Class ;
    rdfs:label "Guilt"@en ;
    rdfs:comment "The emotional experience resulting from the perception of having done something wrong."@en ;
    rdfs:subClassOf :Feeling .

:Hypersomnia a owl:Class ;
    rdfs:label "Hypersomnia"@en ;
    rdfs:comment "Hypersomnia is characterized by excessive daytime sleepiness, leading to prolonged and unrefreshing sleep."@en ;
    rdfs:subClassOf :Sleep .

:Hypomania a owl:Class ;
    rdfs:label "Hypomania"@en ;
    rdfs:comment "A milder form of mania, marked by elation and hyperactivity."@en ;
    rdfs:subClassOf :Bipolar .

:Impairment a owl:Class ;
    rdfs:label "Impairment"@en ;
    rdfs:comment "A reduction in function or ability, often described in the context of physical or mental capabilities."@en ;
    rdfs:subClassOf :Trace .

:ImpulseControl a owl:Class ;
    rdfs:label "Impulse Control"@en ;
    rdfs:comment "The ability to resist or delay an impulse, drive, or temptation to act."@en ;
    rdfs:subClassOf :Cognition .

:Insomnia a owl:Class ;
    rdfs:label "Insomnia"@en ;
    rdfs:comment "Insomnia is characterized by difficulty falling asleep or staying asleep, leading to inadequate or non-restorative sleep."@en ;
    rdfs:subClassOf :Sleep .

:Interest a owl:Class ;
    rdfs:label "Interest"@en ;
    rdfs:comment "The feeling of wanting to know or learn about something or someone."@en ;
    rdfs:subClassOf :Feeling .

:Mania a owl:Class ;
    rdfs:label "Mania"@en ;
    rdfs:comment "A mental state characterized by excessive excitement, energy, and euphoria."@en ;
    rdfs:subClassOf :Bipolar .

:MedicalRecord01 a :MedicalRecord,
        owl:NamedIndividual ;
    :hasMoment "2024-10-05T14:17:44Z"^^xsd:dateTimeStamp ;
    :hasTextContent "The patient underwent a thorough evaluation session, including clinical interviews and psychological assessments, to assess their mental health status. It was concluded that the patient does not exhibit symptoms consistent with depression." ;
    :isAbout :Person01 .

:Pain a owl:Class ;
    rdfs:label "Pain"@en ;
    rdfs:comment "An unpleasant sensory and emotional experience associated with actual or potential tissue damage."@en ;
    rdfs:subClassOf :Feeling .

:Pleasure a owl:Class ;
    rdfs:label "Pleasure"@en ;
    rdfs:comment "A feeling of happy satisfaction and enjoyment."@en ;
    rdfs:subClassOf :Feeling .

