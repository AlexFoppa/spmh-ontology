:PsychomotorActivity a owl:Class ;
    rdfs:label "Psychomotor Activity"@en ;
    rdfs:comment "Physical activities that are influenced by mental processes, including changes in speed or movement associated with mental states."@en ;
    rdfs:subClassOf :Cognition .

:Schizophrenia a owl:Class ;
    rdfs:label "Schizophrenia"@en ;
    rdfs:comment "A long-term mental disorder involving a breakdown in the relation between thought, emotion, and behavior, leading to faulty perception and withdrawal."@en ;
    rdfs:subClassOf :Psychotic .

:SexualAbuse a owl:Class ;
    rdfs:label "Sexual Abuse"@en ;
    rdfs:comment "Any specific trace that can signify sexual abuse."@en ;
    rdfs:subClassOf :Event .

:SignificantLoss a owl:Class ;
    rdfs:label "Significant Loss"@en ;
    rdfs:comment "A substantial and impactful loss that contributes to the development or exacerbation of depressive symptoms, different from a death or a trauma"@en ;
    rdfs:subClassOf :Event .

:SocialIsolation a owl:Class ;
    rdfs:label "Social Isolation"@en ;
    rdfs:comment "A state where an individual lacks a sense of social belonging, social engagement, and fulfilling relationships."@en ;
    rdfs:subClassOf :Feeling .

:SomaticComplaints a owl:Class ;
    rdfs:label "Somatic Complaints"@en ;
    rdfs:comment "Somatic complaints are physical symptoms that may arise from psychological factors, often lacking a clear medical cause."@en ;
    rdfs:subClassOf :Feeling .

:Stress a owl:Class ;
    rdfs:label "Stress"@en ;
    rdfs:comment "A state of mental or emotional strain or tension resulting from adverse or demanding circumstances."@en ;
    rdfs:subClassOf :Feeling .

:SubstanceUse a owl:Class ;
    rdfs:label "Substance Use"@en ;
    rdfs:comment "A trace of substance use other than alcohol, whether illicit or prescribed medication, which may impact the diagnosis of depression"@en ;
    rdfs:subClassOf :Behaviour .

:SuicideAttempt a owl:Class ;
    rdfs:label "Suicide Attempt"@en ;
    rdfs:comment "A suicide attempt is an intentional, self-inflicted action with the purpose of causing one's own death, although it may not result in death."@en ;
    rdfs:subClassOf :SuicidalBehaviour .

:SuicideIdeation a owl:Class ;
    rdfs:label "Suicide Ideation"@en ;
    rdfs:comment "Suicidal ideation refers to thoughts, contemplation, or fantasies about taking one's own life."@en ;
    rdfs:subClassOf :SuicidalBehaviour .

:Thinking a owl:Class ;
    rdfs:label "Thinking"@en ;
    rdfs:comment "The process of considering or reasoning about something; cognitive consideration of information."@en ;
    rdfs:subClassOf :Cognition .

:Trauma a owl:Class ;
    rdfs:label "Trauma"@en ;
    rdfs:comment "A deeply distressing or disturbing experience that overwhelms an individual's ability to cope, often resulting in lasting emotional or psychological effects.\""@en ;
    rdfs:subClassOf :Event .

:Weight a owl:Class ;
    rdfs:label "Weight"@en ;
    rdfs:comment "Pertains to body mass, can refer to changes in weight (gain and/or loss)"@en ;
    rdfs:subClassOf :Condition .

:comesFromSocialPlataform a owl:DatatypeProperty ;
    rdfs:label "comesFromSocialPlatform"@en ;
    rdfs:comment "The social media platform where the publication was published"@en ;
    rdfs:domain :Account ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty ;
    owl:equivalentProperty :comesFromSocialPlatform .

:creates a owl:ObjectProperty ;
    rdfs:label "creates"@en ;
    rdfs:comment "A procedure can create an artifact"@en ;
    rdfs:domain :Procedure ;
    rdfs:range :Artifact ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isResultOf .

:finds a owl:ObjectProperty ;
    rdfs:label "finds"@en ;
    rdfs:comment "A procedure can find a trace"@en ;
    rdfs:domain :Procedure ;
    rdfs:range :Trace ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isFoundUsing .

:hasA a owl:ObjectProperty ;
    rdfs:label "containsTrace"@en ;
    rdfs:comment "A context may have 0 to multiple traces of depression"@en ;
    rdfs:domain :Context ;
    rdfs:range :Trace ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isFoundIn .

:hasAccountUrl a owl:DatatypeProperty ;
    rdfs:label "hasAccountUrl"@en ;
    rdfs:comment "The url of an account"@en ;
    rdfs:domain :Account ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasAge a owl:DatatypeProperty ;
    rdfs:label "hasAge"@en ;
    rdfs:comment "A person's age"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasCapturedMoment a owl:DatatypeProperty ;
    rdfs:label "hasCapturedMoment"@en ;
    rdfs:comment "The moment when an evidence is captured"@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasContext a owl:ObjectProperty ;
    rdfs:label "hasContext"@en ;
    rdfs:comment "A person may have several contexts"@en ;
    rdfs:domain :Person ;
    rdfs:range :Context ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isAbout .

:hasCreationMoment a owl:DatatypeProperty ;
    rdfs:label "hasCreationMoment"@en ;
    rdfs:comment "The moment when an artifact is created"@en ;
    rdfs:domain :Artifact ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasEducation a owl:DatatypeProperty ;
    rdfs:label "hasEducation"@en ;
    rdfs:comment "A person's level of education"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasEpisode a owl:DatatypeProperty ;
    rdfs:label "hasEpisode"@en ;
    rdfs:comment "A flag for mental health conditions with the possibility of having episodes"@en ;
    rdfs:domain :Condition ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasEthnicity a owl:DatatypeProperty ;
    rdfs:label "hasEthnicity"@en ;
    rdfs:comment "A person's ethnicity"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasExplanation a owl:DatatypeProperty ;
    rdfs:label "hasExplanation"@en ;
    rdfs:comment "The documentation of why a text was considered relevant"@en ;
    rdfs:domain :Trace ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasFamily a owl:DatatypeProperty ;
    rdfs:label "hasFamily"@en ;
    rdfs:comment "A person's family member or group"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasGender a owl:DatatypeProperty ;
    rdfs:label "hasGender"@en ;
    rdfs:comment "A person's gender"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasHashcode a owl:DatatypeProperty ;
    rdfs:label "hasHashcode"@en ;
    rdfs:comment "A hashcode for data integrity assurance"@en ;
    rdfs:domain :Artifact ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasImageContent a owl:DatatypeProperty ;
    rdfs:label "hasImageContent"@en ;
    rdfs:comment "The content of a social media publication, specifically image data."@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:base64Binary ;
    rdfs:subPropertyOf :hasContent .

:hasIncome a owl:DatatypeProperty ;
    rdfs:label "hasIncome"@en ;
    rdfs:comment "A person's level of income"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasMoment a owl:DatatypeProperty ;
    rdfs:label "hasMoment"@en ;
    rdfs:comment "The moment when a context (publication or mental record) is created"@en ;
    rdfs:domain :Context ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasName a owl:DatatypeProperty ;
    rdfs:label "hasName"@en ;
    rdfs:comment "A person's name"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasOriginIn a owl:ObjectProperty ;
    rdfs:label "hasOriginIn"@en ;
    rdfs:comment "An artifact is generated based on a social media publication"@en ;
    rdfs:domain :Artifact ;
    rdfs:range :Publication ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isPreservedAs .

:hasRelationship a owl:DatatypeProperty ;
    rdfs:label "hasRelationship"@en ;
    rdfs:comment "A person's relationship"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasSentimentScore a owl:DatatypeProperty ;
    rdfs:label "hasSentimentScore"@en ;
    rdfs:comment "A sentiment score calculated by sentiment analysis techniques"@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasTextContent a owl:DatatypeProperty ;
    rdfs:label "hasTextContent"@en ;
    rdfs:comment "The content of a social media publication, specifically text data."@en ;
    rdfs:domain :Context ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :hasContent .

:hasUrl a owl:DatatypeProperty ;
    rdfs:label "hasUrl"@en ;
    rdfs:comment "The url from where the data from a publication was captured"@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasVideoContent a owl:DatatypeProperty ;
    rdfs:label "hasVideoContent"@en ;
    rdfs:comment "The content of a social media publication, specifically video data."@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf :hasContent .

:isOwned a owl:ObjectProperty ;
    rdfs:label "isOwnedBy"@en ;
    rdfs:comment "A social media account has a person as an owner"@en ;
    rdfs:domain :Account ;
    rdfs:range :Person ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :owns .

:isRelevant a owl:DatatypeProperty ;
    rdfs:label "isRelevant"@en ;
    rdfs:comment "A flag indicating if an artifact is relevant for a depression diagnosis"@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

:publishedInSocialPlatform a owl:DatatypeProperty ;
    rdfs:label "publishedInSocialPlatform"@en ;
    rdfs:comment "The social media platform where the account was created"@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

rdfs:comment rdfs:label "comment"@en ;
    rdfs:comment "Provides a human-readable description of a resource."@en .

rdfs:label rdfs:label "label"@en ;
    rdfs:comment "Provides a human-readable version of a resource name."@en .

owl:versionInfo rdfs:label "version information"@en ;
    rdfs:comment "Annotation property for ontology version metadata."@en .

:AccountID1 a :Account,
        owl:NamedIndividual ;
    :comesFromSocialPlataform "Instagram" ;
    :hasAccountUrl "https://www.instagram.com/REDACTED/" .

:AlcoholUse a owl:Class ;
    rdfs:label "Alcohol Use"@en ;
    rdfs:comment "A trace of alcohol use, whether in a controlled social setting or associated with alcohol abuse."@en ;
    rdfs:subClassOf :Behaviour .

