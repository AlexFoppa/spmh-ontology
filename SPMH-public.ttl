:PostID10 a :Post,
        owl:NamedIndividual ;
    :hasA :Trace02,
        :Trace03 ;
    :hasCapturedMoment "2024-08-05T19:05:54Z"^^xsd:dateTimeStamp ;
    :hasMoment "2020-09-22T22:04:20Z"^^xsd:dateTimeStamp ;
    :hasSentimentScore 0.4574 ;
    :hasTextContent "Due to the pandemic and its impacts on my physical condition, I ended up not being able to attend my graduation ceremony in [REDACTED], and only managed to pick up the diploma today. And, to my surprise, I found with it the certificates of having received the [REDACTED] Honor Student Award and the Outstanding Student award from the [REDACTED]. So, since I didn't have the opportunity to thank at the time, I would like to thank through my social networks for this recognition, as well as to share this news with my friends and ask for apologies for taking so long to send this thanks - it wasn't on purpose, I just didn't know before. I also don't know exactly who to thank... but the feeling is sincere, and I hope it reaches all those involved :) \\n\\n#[REDACTED]HonorStudentAward" ;
    :hasUrl "https://www.instagram.com/p/REDACTED/" ;
    :isAbout :Person01 ;
    :isPreservedAs :Artifact10 ;
    :isRelevant true ;
    :publishedInSocialPlatform "Instagram" .

