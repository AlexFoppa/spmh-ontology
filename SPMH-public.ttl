# Public release: OOPS-clean schema + redacted A-box + HURON v1.0.4.
# Canonical: SPMH-public.owl (QASAR + OOPS!). Turtle export below.
# Namespace: http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH

@prefix : <http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/> .

<http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH> rdf:type owl:Ontology ;
    rdfs:label "Serapis Personal Mental Health Ontology (SPMH)"@en ;
    dc:title "Serapis Personal Mental Health Ontology (SPMH)" ;
    dc:description "Trace-based ontology for organizing depression-related social media evidence with provenance, aligned with DSM-5-TR diagnostic criteria."@en ;
    dc:creator "Alexandre Augusto Foppa, Wesllei Felipe Heckler, Luan Paris Feijó, Jorge Luis Victória Barbosa" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.0.4" .

<http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH> a owl:Ontology ;
    rdfs:label "Serapis Personal Mental Health Ontology (SPMH)"@en ;
    dc:creator "Alexandre Augusto Foppa, Wesllei Felipe Heckler, Luan Paris Feijó, Jorge Luis Victória Barbosa" ;
    dc:description "Trace-based ontology for organizing depression-related social media evidence with provenance, aligned with DSM-5-TR diagnostic criteria."@en ;
    dc:title "Serapis Personal Mental Health Ontology (SPMH)" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.0.4" .

:AlcoholUse rdf:type owl:Class ;
    rdfs:label "Alcohol Use" ;
    rdfs:comment "A trace of alcohol use, whether in a controlled social setting or associated with alcohol abuse." ;
    rdfs:subClassOf :Behaviour .

:Analisys rdf:type owl:Class ;
    rdfs:label "Analisys" ;
    rdfs:comment "A technique for turning data into intelligence." ;
    rdfs:subClassOf :Procedure .

:Appetite rdf:type owl:Class ;
    rdfs:label "Appetite" ;
    rdfs:comment "The natural desire to satisfy bodily needs for food." ;
    rdfs:subClassOf :Feeling .

:Birth rdf:type owl:Class ;
    rdfs:label "Birth" ;
    rdfs:comment "The birth of a child" ;
    rdfs:subClassOf :Event .

:ChildhoodExperiences rdf:type owl:Class ;
    rdfs:label "Childhood Experiences" ;
    rdfs:comment "Any traumas or memorable experiences from the person's childhood that may influence a depression diagnosis" ;
    rdfs:subClassOf :Event .

:Collection rdf:type owl:Class ;
    rdfs:label "Collection" ;
    rdfs:comment "A technique used to collect the data." ;
    rdfs:subClassOf :Procedure .

:Concentration rdf:type owl:Class ;
    rdfs:label "Concentration" ;
    rdfs:comment "The ability to focus attention on a task for a sustained period of time." ;
    rdfs:subClassOf :Cognition .

:Death rdf:type owl:Class ;
    rdfs:label "Death" ;
    rdfs:comment "A death of a familiar, friend or any significant people that may cause grief, including pets." ;
    rdfs:subClassOf :Event .

:DecisionMaking rdf:type owl:Class ;
    rdfs:label "DecisionMaking" ;
    rdfs:comment "The process of making choices by identifying options and assessing the impact of each option." ;
    rdfs:subClassOf :Cognition .

:Delusion rdf:type owl:Class ;
    rdfs:label "Delusion" ;
    rdfs:comment "A false belief held with strong conviction despite superior evidence to the contrary." ;
    rdfs:subClassOf :Cognition .

:DepressedMood rdf:type owl:Class ;
    rdfs:label "DepressedMood" ;
    rdfs:comment "Persistent sadness and a lack of interest or pleasure in previously rewarding or enjoyable activities. Synonyms: Sadness, Rumination, Worthlessness, Distress, Indecisiveness, Hopelessness, Melancholy and Loneliness" ;
    rdfs:subClassOf :Feeling .

:Depression rdf:type owl:Class ;
    rdfs:label "Depression" ;
    rdfs:comment "A psychiatric condition marked by significant sadness, lack of energy, and low mood." ;
    rdfs:subClassOf :Condition .

:Discrimination rdf:type owl:Class ;
    rdfs:label "Discrimination" ;
    rdfs:comment "Unjust or prejudicial treatment of different categories of people, often based on race, age, or gender." ;
    rdfs:subClassOf :Feeling .

:Fatigue rdf:type owl:Class ;
    rdfs:label "Fatigue" ;
    rdfs:comment "Fatigue is a state of tiredness or exhaustion resulting from mental or physical exertion or illness. Synonyms:Burrden, Energy (Lack of), Tiredness" ;
    rdfs:subClassOf :Feeling .

:Gastrointestinal rdf:type owl:Class ;
    rdfs:label "Gastrointestinal" ;
    rdfs:comment "Disturbances in the stomach and intestines." ;
    rdfs:subClassOf :Condition .

:Guilt rdf:type owl:Class ;
    rdfs:label "Guilt" ;
    rdfs:comment "The emotional experience resulting from the perception of having done something wrong." ;
    rdfs:subClassOf :Feeling .

:Hypersomnia rdf:type owl:Class ;
    rdfs:label "Hypersomnia" ;
    rdfs:comment "Hypersomnia is characterized by excessive daytime sleepiness, leading to prolonged and unrefreshing sleep." ;
    rdfs:subClassOf :Sleep .

:Hypomania rdf:type owl:Class ;
    rdfs:label "Hypomania" ;
    rdfs:comment "A milder form of mania, marked by elation and hyperactivity." ;
    rdfs:subClassOf :Bipolar .

:Identification rdf:type owl:Class ;
    rdfs:label "Identification" ;
    rdfs:comment "A technique used identify the data that must be collected" ;
    rdfs:subClassOf :Procedure .

:Impairment rdf:type owl:Class ;
    rdfs:label "Impairment" ;
    rdfs:comment "A reduction in function or ability, often described in the context of physical or mental capabilities." ;
    rdfs:subClassOf :Trace .

:ImpulseControl rdf:type owl:Class ;
    rdfs:label "Impulse Control" ;
    rdfs:comment "The ability to resist or delay an impulse, drive, or temptation to act." ;
    rdfs:subClassOf :Cognition .

:Insomnia rdf:type owl:Class ;
    rdfs:label "Insomnia" ;
    rdfs:comment "Insomnia is characterized by difficulty falling asleep or staying asleep, leading to inadequate or non-restorative sleep." ;
    rdfs:subClassOf :Sleep .

:Interest rdf:type owl:Class ;
    rdfs:label "Interest" ;
    rdfs:comment "The feeling of wanting to know or learn about something or someone." ;
    rdfs:subClassOf :Feeling .

:Irritability rdf:type owl:Class ;
    rdfs:label "Irritability" ;
    rdfs:comment "The quality or state of being easily annoyed or provoked to anger." ;
    rdfs:subClassOf :Feeling .

:Mania rdf:type owl:Class ;
    rdfs:label "Mania" ;
    rdfs:comment "A mental state characterized by excessive excitement, energy, and euphoria." ;
    rdfs:subClassOf :Bipolar .

:MedicalRecord rdf:type owl:Class ;
    rdfs:label "Medical Records" ;
    rdfs:comment "Medical records generated by a professional recording the relevant information after a medical or therapeutic appointment." ;
    rdfs:subClassOf :Context .

:Pain rdf:type owl:Class ;
    rdfs:label "Pain" ;
    rdfs:comment "An unpleasant sensory and emotional experience associated with actual or potential tissue damage." ;
    rdfs:subClassOf :Feeling .

:Pleasure rdf:type owl:Class ;
    rdfs:label "Pleasure" ;
    rdfs:comment "A feeling of happy satisfaction and enjoyment." ;
    rdfs:subClassOf :Feeling .

:Post rdf:type owl:Class ;
    rdfs:label "Post" ;
    rdfs:comment "A publication on a social media platform, presented as a post, represents a timestamped update that remains independent from other posts, contrasting with profile updates that overwrite the previous content." ;
    rdfs:subClassOf :Publication .

:Presentation rdf:type owl:Class ;
    rdfs:label "Presentation" ;
    rdfs:comment "A technique used to share the intelligence produced." ;
    rdfs:subClassOf :Procedure .

:Profile rdf:type owl:Class ;
    rdfs:label "Profile" ;
    rdfs:comment "A publication on a social media platform, presented as a profile, represents an update of the users profile, usually whitout timestamp that overwrite the previous content." ;
    rdfs:subClassOf :Publication .

:PsychomotorActivity rdf:type owl:Class ;
    rdfs:label "Psychomotor Activity" ;
    rdfs:comment "Physical activities that are influenced by mental processes, including changes in speed or movement associated with mental states." ;
    rdfs:subClassOf :Cognition .

:Relation rdf:type owl:Class ;
    rdfs:label "Relation" ;
    rdfs:comment "Refers to a significant connection with someone like a parent or a pet, characterized by emotional bonds and personal attachment." ;
    rdfs:subClassOf :Trace .

:Schizophrenia rdf:type owl:Class ;
    rdfs:label "Schizophrenia" ;
    rdfs:comment "A long-term mental disorder involving a breakdown in the relation between thought, emotion, and behavior, leading to faulty perception and withdrawal." ;
    rdfs:subClassOf :Psychotic .

:SexualAbuse rdf:type owl:Class ;
    rdfs:label "Sexual Abuse" ;
    rdfs:comment "Any specific trace that can signify sexual abuse." ;
    rdfs:subClassOf :Event .

:SignificantLoss rdf:type owl:Class ;
    rdfs:label "Significant Loss" ;
    rdfs:comment "A substantial and impactful loss that contributes to the development or exacerbation of depressive symptoms, different from a death or a trauma" ;
    rdfs:subClassOf :Event .

:SocialIsolation rdf:type owl:Class ;
    rdfs:label "Social Isolation" ;
    rdfs:comment "A state where an individual lacks a sense of social belonging, social engagement, and fulfilling relationships." ;
    rdfs:subClassOf :Feeling .

:SomaticComplaints rdf:type owl:Class ;
    rdfs:label "Somatic Complaints" ;
    rdfs:comment "Somatic complaints are physical symptoms that may arise from psychological factors, often lacking a clear medical cause." ;
    rdfs:subClassOf :Feeling .

:Storage rdf:type owl:Class ;
    rdfs:label "Evidence storage procedure"@en ;
    rdfs:comment "Procedure step for storing collected digital evidence with integrity controls."@en ;
    rdfs:subClassOf :Procedure ;
    owl:disjointWith :Memory .

:Stress rdf:type owl:Class ;
    rdfs:label "Stress" ;
    rdfs:comment "A state of mental or emotional strain or tension resulting from adverse or demanding circumstances." ;
    rdfs:subClassOf :Feeling .

:SubstanceUse rdf:type owl:Class ;
    rdfs:label "Substance Use" ;
    rdfs:comment "A trace of substance use other than alcohol, whether illicit or prescribed medication, which may impact the diagnosis of depression" ;
    rdfs:subClassOf :Behaviour .

:SuicideAttempt rdf:type owl:Class ;
    rdfs:label "Suicide Attempt" ;
    rdfs:comment "A suicide attempt is an intentional, self-inflicted action with the purpose of causing one's own death, although it may not result in death." ;
    rdfs:subClassOf :SuicidalBehaviour .

:SuicideIdeation rdf:type owl:Class ;
    rdfs:label "Suicide Ideation" ;
    rdfs:comment "Suicidal ideation refers to thoughts, contemplation, or fantasies about taking one's own life." ;
    rdfs:subClassOf :SuicidalBehaviour .

:Thinking rdf:type owl:Class ;
    rdfs:label "Thinking" ;
    rdfs:comment "The process of considering or reasoning about something; cognitive consideration of information." ;
    rdfs:subClassOf :Cognition .

:Trauma rdf:type owl:Class ;
    rdfs:label "Trauma" ;
    rdfs:comment "A deeply distressing or disturbing experience that overwhelms an individual's ability to cope, often resulting in lasting emotional or psychological effects.\"" ;
    rdfs:subClassOf :Event .

:Weight rdf:type owl:Class ;
    rdfs:label "Weight" ;
    rdfs:comment "Pertains to body mass, can refer to changes in weight (gain and/or loss)" ;
    rdfs:subClassOf :Condition .

:comesFromSocialPlataform rdf:type owl:DatatypeProperty ;
    rdfs:label "comesFromSocialPlatform" ;
    rdfs:comment "The social media platform where the publication was published" ;
    rdfs:domain :Account ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty ;
    owl:equivalentProperty :comesFromSocialPlatform .

:creates rdf:type owl:ObjectProperty ;
    rdfs:label "creates" ;
    rdfs:comment "A procedure can create an artifact" ;
    rdfs:domain :Procedure ;
    rdfs:range :Artifact ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isResultOf .

:finds rdf:type owl:ObjectProperty ;
    rdfs:label "finds" ;
    rdfs:comment "A procedure can find a trace" ;
    rdfs:domain :Procedure ;
    rdfs:range :Trace ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isFoundUsing .

:hasA rdf:type owl:ObjectProperty ;
    rdfs:label "containsTrace" ;
    rdfs:comment "A context may have 0 to multiple traces of depression" ;
    rdfs:domain :Context ;
    rdfs:range :Trace ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isFoundIn .

:hasAccountUrl rdf:type owl:DatatypeProperty ;
    rdfs:label "hasAccountUrl" ;
    rdfs:comment "The url of an account" ;
    rdfs:domain :Account ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasAge rdf:type owl:DatatypeProperty ;
    rdfs:label "hasAge" ;
    rdfs:comment "A person's age" ;
    rdfs:domain :Person ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasCapturedMoment rdf:type owl:DatatypeProperty ;
    rdfs:label "hasCapturedMoment" ;
    rdfs:comment "The moment when an evidence is captured" ;
    rdfs:domain :Publication ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasContext rdf:type owl:ObjectProperty ;
    rdfs:label "hasContext" ;
    rdfs:comment "A person may have several contexts" ;
    rdfs:domain :Person ;
    rdfs:range :Context ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isAbout .

:hasCreationMoment rdf:type owl:DatatypeProperty ;
    rdfs:label "hasCreationMoment" ;
    rdfs:comment "The moment when an artifact is created" ;
    rdfs:domain :Artifact ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasEducation rdf:type owl:DatatypeProperty ;
    rdfs:label "hasEducation" ;
    rdfs:comment "A person's level of education" ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasEpisode rdf:type owl:DatatypeProperty ;
    rdfs:label "hasEpisode" ;
    rdfs:comment "A flag for mental health conditions with the possibility of having episodes" ;
    rdfs:domain :Condition ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasEthnicity rdf:type owl:DatatypeProperty ;
    rdfs:label "hasEthnicity" ;
    rdfs:comment "A person's ethnicity" ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasExplanation rdf:type owl:DatatypeProperty ;
    rdfs:label "hasExplanation" ;
    rdfs:comment "The documentation of why a text was considered relevant" ;
    rdfs:domain :Trace ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasFamily rdf:type owl:DatatypeProperty ;
    rdfs:label "hasFamily" ;
    rdfs:comment "A person's family member or group" ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasGender rdf:type owl:DatatypeProperty ;
    rdfs:label "hasGender" ;
    rdfs:comment "A person's gender" ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasHashcode rdf:type owl:DatatypeProperty ;
    rdfs:label "hasHashcode" ;
    rdfs:comment "A hashcode for data integrity assurance" ;
    rdfs:domain :Artifact ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasImageContent rdf:type owl:DatatypeProperty ;
    rdfs:label "hasImageContent" ;
    rdfs:comment "The content of a social media publication, specifically image data." ;
    rdfs:domain :Publication ;
    rdfs:range xsd:base64Binary ;
    rdfs:subPropertyOf :hasContent .

:hasIncome rdf:type owl:DatatypeProperty ;
    rdfs:label "hasIncome" ;
    rdfs:comment "A person's level of income" ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasMoment rdf:type owl:DatatypeProperty ;
    rdfs:label "hasMoment" ;
    rdfs:comment "The moment when a context (publication or mental record) is created" ;
    rdfs:domain :Context ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasName rdf:type owl:DatatypeProperty ;
    rdfs:label "hasName" ;
    rdfs:comment "A person's name" ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasOriginIn rdf:type owl:ObjectProperty ;
    rdfs:label "hasOriginIn" ;
    rdfs:comment "An artifact is generated based on a social media publication" ;
    rdfs:domain :Artifact ;
    rdfs:range :Publication ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :isPreservedAs .

:hasRelationship rdf:type owl:DatatypeProperty ;
    rdfs:label "hasRelationship" ;
    rdfs:comment "A person's relationship" ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasSentimentScore rdf:type owl:DatatypeProperty ;
    rdfs:label "hasSentimentScore" ;
    rdfs:comment "A sentiment score calculated by sentiment analysis techniques" ;
    rdfs:domain :Publication ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasTextContent rdf:type owl:DatatypeProperty ;
    rdfs:label "hasTextContent" ;
    rdfs:comment "The content of a social media publication, specifically text data." ;
    rdfs:domain :Context ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :hasContent .

:hasUrl rdf:type owl:DatatypeProperty ;
    rdfs:label "hasUrl" ;
    rdfs:comment "The url from where the data from a publication was captured" ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:hasVideoContent rdf:type owl:DatatypeProperty ;
    rdfs:label "hasVideoContent" ;
    rdfs:comment "The content of a social media publication, specifically video data." ;
    rdfs:domain :Publication ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf :hasContent .

:isOwned rdf:type owl:ObjectProperty ;
    rdfs:label "isOwnedBy" ;
    rdfs:comment "A social media account has a person as an owner" ;
    rdfs:domain :Account ;
    rdfs:range :Person ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf :owns .

:isRelevant rdf:type owl:DatatypeProperty ;
    rdfs:label "isRelevant" ;
    rdfs:comment "A flag indicating if an artifact is relevant for a depression diagnosis" ;
    rdfs:domain :Publication ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

:publishedInSocialPlatform rdf:type owl:DatatypeProperty ;
    rdfs:label "publishedInSocialPlatform" ;
    rdfs:comment "The social media platform where the account was created" ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:Memory rdf:type owl:Class ;
    rdfs:label "Memory difficulty"@en ;
    rdfs:comment "Difficulty retrieving memories, a cognitive symptom associated with depression."@en ;
    rdfs:subClassOf :Cognition .

:Psychotic rdf:type owl:Class ;
    rdfs:label "Psychotic" ;
    rdfs:comment "Conditions related to psychosis disorders, which includes delusions or hallucinations, often involving a loss of contact with reality." ;
    rdfs:subClassOf :Condition .

:comesFromSocialPlatform rdf:type owl:DatatypeProperty ;
    rdfs:label "comesFromSocialPlatform" ;
    rdfs:comment "The social media platform where the publication was published" ;
    rdfs:domain :Account ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:isAbout rdf:type owl:ObjectProperty ;
    rdfs:label "isAbout" ;
    rdfs:comment "A context is about a specific person" ;
    rdfs:domain :Context ;
    rdfs:range :Person ;
    rdfs:subPropertyOf owl:topObjectProperty .

:isFoundIn rdf:type owl:ObjectProperty ;
    rdfs:label "isFoundIn" ;
    rdfs:comment "A trace is found in a specific publication or medical record" ;
    rdfs:domain :Trace ;
    rdfs:range :Context ;
    rdfs:subPropertyOf owl:topObjectProperty .

:isFoundUsing rdf:type owl:ObjectProperty ;
    rdfs:label "isFoundUsing" ;
    rdfs:comment "A trace is found using a specific procedure" ;
    rdfs:domain :Trace ;
    rdfs:range :Procedure ;
    rdfs:subPropertyOf owl:topObjectProperty .

:isPreservedAs rdf:type owl:ObjectProperty ;
    rdfs:label "isPreservedAs" ;
    rdfs:comment "An artifact generated to preserve a social media publication" ;
    rdfs:domain :Publication ;
    rdfs:range :Artifact ;
    rdfs:subPropertyOf owl:topObjectProperty .

:isResultOf rdf:type owl:ObjectProperty ;
    rdfs:label "isResultOf" ;
    rdfs:comment "An artifact is the result of a procedure" ;
    rdfs:domain :Artifact ;
    rdfs:range :Procedure ;
    rdfs:subPropertyOf owl:topObjectProperty .

:owns rdf:type owl:ObjectProperty ;
    rdfs:label "owns" ;
    rdfs:comment "The relation of a person with his social media  account" ;
    rdfs:domain :Person ;
    rdfs:range :Account ;
    rdfs:subPropertyOf owl:topObjectProperty .

:Bipolar rdf:type owl:Class ;
    rdfs:label "Bipolar" ;
    rdfs:comment "A psychiatric condition characterized by extreme mood swings, including manic and depressive episodes." ;
    rdfs:subClassOf :Condition .

:Sleep rdf:type owl:Class ;
    rdfs:label "Sleep" ;
    rdfs:comment "Sleep refers to traces of the natural state of rest undergo by people" ;
    rdfs:subClassOf :Behaviour .

:SuicidalBehaviour rdf:type owl:Class ;
    rdfs:label "Suicidal Behaviour" ;
    rdfs:comment "Suicidal behavior refers to actions or thoughts that involve an individual contemplating or attempting to take their own life." ;
    rdfs:subClassOf :Behaviour .

:hasContent rdf:type owl:DatatypeProperty ;
    rdfs:label "hasContent" ;
    rdfs:comment "The content of a social media publication in general" ;
    rdfs:domain :Context ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

:Behaviour rdf:type owl:Class ;
    rdfs:label "Behaviour" ;
    rdfs:comment "Behavior encompasses actions, reactions, or conduct displayed by individuals in various situations, reflecting their thoughts, feelings, and intentions." ;
    rdfs:subClassOf :Trace .

:Account rdf:type owl:Class ;
    rdfs:label "Account" ;
    rdfs:comment "A personal social media account" .

:Condition rdf:type owl:Class ;
    rdfs:label "Condition" ;
    rdfs:comment "A state of health, whether normal or disrupted, that may influences the depression diagnosis." ;
    rdfs:subClassOf :Trace .

:Event rdf:type owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A significant event in a persons life that can affected a depression diagnoses" ;
    rdfs:subClassOf :Trace .

:Artifact rdf:type owl:Class ;
    rdfs:label "Artifact" ;
    rdfs:comment "Any data that provides evidence of computer activity or digital interactions, preserved for analysis and trackability." .

:Cognition rdf:type owl:Class ;
    rdfs:label "Cognition" ;
    rdfs:comment "The mental action or process of acquiring knowledge and understanding through thought, experience, and the senses." ;
    rdfs:subClassOf :Trace .

:Context rdf:type owl:Class ;
    rdfs:label "Context" ;
    rdfs:comment "Historical data and conditions that influence or relate to the current state and behavior of the subject." .

:Procedure rdf:type owl:Class ;
    rdfs:label "Procedure" ;
    rdfs:comment "A technique used to turn raw data into intelligence." .

:Publication rdf:type owl:Class ;
    rdfs:label "Publication" ;
    rdfs:comment "A publication made in a social media platform by a person" ;
    rdfs:subClassOf :Context .

:Feeling rdf:type owl:Class ;
    rdfs:label "Feeling" ;
    rdfs:comment "An emotional state or reaction that is experienced internally and expressed outwardly" ;
    rdfs:subClassOf :Trace .

:Person rdf:type owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A person subject of the investigation" .

:Trace rdf:type owl:Class ;
    rdfs:label "Trace" ;
    rdfs:comment "A subtype of material evidence is trace evidence, which consists of small amounts (often microscopic) of material found at a crime scene that can also be relevant to an investigation." .

[] a owl:AllDisjointClasses ;
    owl:members ( :Account :Artifact :Context :Person :Procedure :Trace ) .

#################################################################
#    Individuals
#################################################################
#################################################################

###  http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/AccountID1
