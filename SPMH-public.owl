    <isAbout rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Person01"/>
    <isPreservedAs rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Artifact07"/>
    <publishedInSocialPlatform>Instagram</publishedInSocialPlatform>
    <hasCapturedMoment rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2024-08-05T19:05:54Z</hasCapturedMoment>
    <hasMoment rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2021-04-29T22:05:03Z</hasMoment>
    <hasSentimentScore rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4588</hasSentimentScore>
    <hasTextContent>In the first meeting with a new coworker, she said that I look like a character from The Lord of the Rings. I thought it was funny, so I decided to check if my social isolation look resembles any of the bearded ones, or if I'm an original character. What do you think?</hasTextContent>
    <hasUrl>https://www.instagram.com/p/REDACTED/</hasUrl>
    <isRelevant rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isRelevant>
  </rdf:Description>
