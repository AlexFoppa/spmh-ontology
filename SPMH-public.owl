  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Post">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Post</rdfs:label>
    <rdfs:comment>A publication on a social media platform, presented as a post, represents a timestamped update that remains independent from other posts, contrasting with profile updates that overwrite the previous content.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Publication"/>
  </rdf:Description>
