    <rdfs:range rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Artifact"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/isResultOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/hasVideoContent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasVideoContent</rdfs:label>
    <rdfs:comment>The content of a social media publication, specifically video data.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Publication"/>
