    <rdfs:label>Mania</rdfs:label>
    <rdfs:comment>A mental state characterized by excessive excitement, energy, and euphoria.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Bipolar"/>
  </rdf:Description>
