    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>comesFromSocialPlatform</rdfs:label>
    <rdfs:comment>The social media platform where the publication was published</rdfs:comment>
