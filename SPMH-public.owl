  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/SubstanceUse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Substance Use</rdfs:label>
    <rdfs:comment>A trace of substance use other than alcohol, whether illicit or prescribed medication, which may impact the diagnosis of depression</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Behaviour"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/hasGender">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasGender</rdfs:label>
    <rdfs:comment>A person's gender</rdfs:comment>
