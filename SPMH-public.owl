    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#base64Binary"/>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/hasContent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Appetite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Appetite</rdfs:label>
    <rdfs:comment>The natural desire to satisfy bodily needs for food.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Feeling"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Death">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Death</rdfs:label>
    <rdfs:comment>A death of a familiar, friend or any significant people that may cause grief, including pets.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Stress">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Stress</rdfs:label>
    <rdfs:comment>A state of mental or emotional strain or tension resulting from adverse or demanding circumstances.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Feeling"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/SocialIsolation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Social Isolation</rdfs:label>
    <rdfs:comment>A state where an individual lacks a sense of social belonging, social engagement, and fulfilling relationships.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Feeling"/>
  </rdf:Description>
