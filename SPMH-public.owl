    <isRelevant rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isRelevant>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/PostID06">
