  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Psychotic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Psychotic</rdfs:label>
    <rdfs:comment>Conditions related to psychosis disorders, which includes delusions or hallucinations, often involving a loss of contact with reality.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Condition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Trace09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Relation"/>
    <isFoundUsing rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/LLMTraceDetection"/>
    <hasExplanation>The text indicates a relationship of affection and loss (the speaker and the deceased referred to as "dear [REDACTED]")</hasExplanation>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/isPreservedAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>isPreservedAs</rdfs:label>
    <rdfs:comment>An artifact generated to preserve a social media publication</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Publication"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Artifact"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Gastrointestinal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Gastrointestinal</rdfs:label>
    <rdfs:comment>Disturbances in the stomach and intestines.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Condition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/hasImageContent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasImageContent</rdfs:label>
    <rdfs:comment>The content of a social media publication, specifically image data.</rdfs:comment>
