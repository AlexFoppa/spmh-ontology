    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Trace</rdfs:label>
    <rdfs:comment>A subtype of material evidence is trace evidence, which consists of small amounts (often microscopic) of material found at a crime scene that can also be relevant to an investigation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/hasAccountUrl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
