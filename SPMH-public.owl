    <isPreservedAs rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Artifact09"/>
    <publishedInSocialPlatform>Instagram</publishedInSocialPlatform>
    <hasCapturedMoment rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2024-08-05T19:05:54Z</hasCapturedMoment>
    <hasMoment rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-12-24T23:47:39Z</hasMoment>
    <hasSentimentScore rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2263</hasSentimentScore>
    <hasTextContent>Want a loving companion for the next year? How about one of these kittens?</hasTextContent>
    <hasUrl>https://www.instagram.com/p/REDACTED/</hasUrl>
    <isRelevant rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isRelevant>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Artifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Artifact</rdfs:label>
    <rdfs:comment>Any data that provides evidence of computer activity or digital interactions, preserved for analysis and trackability.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/SignificantLoss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Significant Loss</rdfs:label>
    <rdfs:comment>A substantial and impactful loss that contributes to the development or exacerbation of depressive symptoms, different from a death or a trauma</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/hasName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasName</rdfs:label>
    <rdfs:comment>A person's name</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Serapis Personal Mental Health Ontology (SPMH)</rdfs:label>
    <dc:title>Serapis Personal Mental Health Ontology (SPMH)</dc:title>
    <dc:description xml:lang="en">Trace-based ontology for organizing depression-related social media evidence with provenance, aligned with DSM-5-TR diagnostic criteria.</dc:description>
    <dc:creator>Alexandre Augusto Foppa, Wesllei Felipe Heckler, Luan Paris Feijó, Jorge Luis Victória Barbosa</dc:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionInfo>1.0.4</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Trace17">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Feeling"/>
    <isFoundUsing rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/LLMTraceDetection"/>
    <hasExplanation>the text might convey sentiments of disappointment or dissatisfaction regarding the artistic outcome, reflecting feelings such as frustration.</hasExplanation>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Relation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Relation</rdfs:label>
    <rdfs:comment>Refers to a significant connection with someone like a parent or a pet, characterized by emotional bonds and personal attachment.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Trace"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Storage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evidence storage procedure</rdfs:label>
    <rdfs:comment xml:lang="en">Procedure step for storing collected digital evidence with integrity controls.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Procedure"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Memory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Bipolar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bipolar</rdfs:label>
    <rdfs:comment>A psychiatric condition characterized by extreme mood swings, including manic and depressive episodes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Condition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/hasOriginIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasOriginIn</rdfs:label>
    <rdfs:comment>An artifact is generated based on a social media publication</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Artifact"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Publication"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/isPreservedAs"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Trace16">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Feeling"/>
    <isFoundUsing rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/LLMTraceDetection"/>
    <hasExplanation>Potentially, the text might convey a sense of relaxation or enjoyment from engaging in a leisure activity (drawing) during the holidays, but these sentiments are not explicitly mentioned.</hasExplanation>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/ChildhoodExperiences">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Childhood Experiences</rdfs:label>
    <rdfs:comment>Any traumas or memorable experiences from the person's childhood that may influence a depression diagnosis</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/hasA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>containsTrace</rdfs:label>
    <rdfs:comment>A context may have 0 to multiple traces of depression</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Context"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Trace"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/isFoundIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/SexualAbuse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Sexual Abuse</rdfs:label>
    <rdfs:comment>Any specific trace that can signify sexual abuse.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/hasHashcode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasHashcode</rdfs:label>
    <rdfs:comment>A hashcode for data integrity assurance</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/spmh/ontologies/2024/3/SPMH/Artifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  </rdf:Description>
